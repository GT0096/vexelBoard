{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vexelboard Shape Library",
  "type": "object",
  "required": [
    "name",
    "version",
    "viewBox",
    "count",
    "categories",
    "shapes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "viewBox": {
      "type": "string"
    },
    "generatedBy": {
      "type": "string"
    },
    "count": {
      "type": "integer"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "sources",
          "size",
          "paths",
          "aliases",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "essentials",
                "standard"
              ]
            }
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "d",
                "fill"
              ],
              "properties": {
                "d": {
                  "type": "string"
                },
                "fill": {
                  "type": "string",
                  "enum": [
                    "fill",
                    "none",
                    "shade",
                    "light",
                    "solid"
                  ]
                },
                "rule": {
                  "type": "string",
                  "enum": [
                    "evenodd",
                    "nonzero"
                  ]
                },
                "dash": {
                  "type": "string",
                  "enum": [
                    "dash",
                    "dot",
                    "dashdot"
                  ]
                },
                "stroke": {
                  "type": "string"
                },
                "sw": {
                  "type": "number"
                }
              }
            }
          },
          "text": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "defaultFill": {
            "type": "string"
          },
          "defaultLabel": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
