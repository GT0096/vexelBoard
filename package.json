{
  "name": "vexelboard",
  "productName": "Vexelboard",
  "version": "1.0.0",
  "description": "Vexelboard — AI-Powered Interactive Whiteboard Studio",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "author": {
    "name": "Vexelboard",
    "url": "https://github.com/GT0096/vexelBoard"
  },
  "homepage": "https://github.com/GT0096/vexelBoard",
  "repository": {
    "type": "git",
    "url": "https://github.com/GT0096/vexelBoard.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "generate:shapes": "node scripts/generate-shape-library.mjs",
    "cert:win": "powershell -ExecutionPolicy Bypass -File scripts/generate-dev-cert.ps1",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:universal": "npm run build && electron-builder --mac --universal",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@types/dagre": "^0.7.54",
    "@types/katex": "^0.16.8",
    "@uiw/codemirror-extensions-langs": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@visioncortex/vtracer": "^1.0.0-alpha.4",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.2.0",
    "elkjs": "^0.12.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "pdf-parse": "^2.4.5",
    "perfect-freehand": "^1.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sqlite-vec": "^0.1.9",
    "svgo": "^4.1.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "katex@>=0.11.0 <0.18.2": "^0.18.2"
  }
}
